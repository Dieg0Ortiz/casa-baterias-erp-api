# Entorno
NODE_ENV=development
PORT=3000

# Supabase — obtener en https://supabase.com/dashboard -> proyecto -> Settings -> API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica
SUPABASE_JWT_SECRET=tu-jwt-secret (Settings -> API -> JWT Secret)

# Solo para creación de usuarios por el administrador (admin API). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
